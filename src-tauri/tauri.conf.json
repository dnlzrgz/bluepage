{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bluepage",
  "version": "../package.json",
  "identifier": "com.daniel.bluepage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bluepage",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "dnlzrgz",
    "homepage": "https://github.com/dnlzrgz/bluepage",
    "copyright": "Copyright © 2026 dnlzrgz",
    "category": "Productivity",
    "shortDescription": "A minimal journal application",
    "longDescription": "A minimal, simple, and bluish journal application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
